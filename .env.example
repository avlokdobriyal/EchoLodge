# Copy to .env (project root) and fill in real values. Never commit the real .env.

# --- NextAuth (server-side) ------------------------------------------------
# Long random string used to sign the NextAuth session JWT.
NEXTAUTH_SECRET="change-me"
# The frontend's own URL. http://localhost:3000 locally; Vercel sets this
# automatically in production (or set it to the live Vercel URL).
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth credentials (Google Cloud Console → APIs → Credentials).
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Express API origin ----------------------------------------------------
# Public (inlined into the browser bundle at build time). Leave unset locally
# to fall back to http://localhost:5000; on Vercel set it to the Render URL.
# NEXT_PUBLIC_API_URL="https://your-backend.onrender.com"

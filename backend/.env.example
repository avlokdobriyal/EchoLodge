# Copy to backend/.env and fill in real values. Never commit the real .env.

# Supabase Postgres — both via the transaction pooler (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"

# Secret used to sign backend JWTs. Use a long random string.
JWT_SECRET="change-me"

# Google Gemini key for review analysis + the AI concierge.
GEMINI_API_KEY="your-gemini-api-key"
# Optional: pin a specific model (defaults to gemini-flash-latest).
# GEMINI_MODEL="gemini-flash-latest"

# The frontend origin allowed by CORS. Locally this can stay unset
# (localhost:3000 is always allowed); in production set it to the Vercel URL.
# FRONTEND_URL="https://your-app.vercel.app"

# Port to listen on. Render injects this automatically; local default is 5000.
# PORT=5000
